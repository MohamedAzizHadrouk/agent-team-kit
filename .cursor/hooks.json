{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [{ "command": "node tools/credit-log.cjs hook --tool cursor --event beforeSubmitPrompt" }],
    "preToolUse": [{ "command": "node tools/file-lock.cjs hook --tool cursor --event preToolUse", "matcher": "Write" }],
    "afterAgentResponse": [{ "command": "node tools/credit-log.cjs hook --tool cursor --event afterAgentResponse" }],
    "stop": [
      { "command": "node tools/credit-log.cjs hook --tool cursor --event stop" },
      { "command": "node tools/file-lock.cjs hook --tool cursor --event stop" }
    ]
  }
}
