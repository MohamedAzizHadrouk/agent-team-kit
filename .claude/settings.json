{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/file-lock.cjs\" hook --tool claude --event pre", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/credit-log.cjs\" hook --tool claude", "timeout": 30 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/file-lock.cjs\" hook --tool claude --event stop", "timeout": 10 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/credit-log.cjs\" hook --tool claude", "timeout": 30 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/file-lock.cjs\" hook --tool claude --event subagent-stop", "timeout": 10 }
        ]
      }
    ]
  }
}
