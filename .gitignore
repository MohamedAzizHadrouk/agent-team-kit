# ── Privacy: this repo shares only the STRUCTURE (agents, rules, templates, tools). ──
# All client data stays on this computer: client folders, people, documents, the registry.
entities/*
!entities/_templates/
!entities/_templates/**

# Local Claude Code settings and scratch files
.claude/settings.local.json
# Dev-server launch configs point at client project folders
.claude/launch.json
*.tmp

# ── Privacy: personal ecosystem (profile, skills, news) stays on this computer. ──
# Only the empty skeletons in ecosystem/_templates/ are shared.
ecosystem/*
!ecosystem/_templates/
!ecosystem/_templates/**

# ── Local-only working files ──
# File locks: one file per locked file, written by tools/file-lock.cjs (private, local only)
.wakil/locks/
# Items archived from Wakil Desktop (recoverable copies)
.wakil/archive/
# Old local data from a retired feature – never shared
/usage/
